{
  "name": "JJA DEV LABS — Symfony PHP 8.3",
  "dockerComposeFile": [
    "../compose.yaml",
    "../compose.override.yaml",
    "../compose.devcontainer.yaml"
  ],
  "service": "php",
  "workspaceFolder": "/var/www/html",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",
  "forwardPorts": [8000, 8025],
  "portsAttributes": {
    "8000": {
      "label": "Symfony local server",
      "onAutoForward": "openBrowser"
    },
    "8025": {
      "label": "Mailpit",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "xdebug.php-debug",
        "bmewburn.vscode-intelephense-client",
        "junstyle.php-cs-fixer",
        "neilbrayfield.php-docblocker",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "mikestead.dotenv",
        "EditorConfig.EditorConfig",
        "symfony.vscode-symfony",
        "bradlc.vscode-tailwindcss",
        "GitHub.vscode-pull-request-github",
        "eamodio.gitlens"
      ],
      "settings": {
        "php.validate.executablePath": "/usr/local/bin/php",
        "php.suggest.basic": false,
        "editor.formatOnSave": true,
        "[php]": {
          "editor.defaultFormatter": "junstyle.php-cs-fixer"
        },
        "files.exclude": {
          "**/var/cache": true,
          "**/var/log": true
        },
        "search.exclude": {
          "**/vendor": true,
          "**/var/cache": true,
          "**/var/log": true,
          "**/node_modules": true
        }
      }
    }
  },
  "postCreateCommand": "if [ -f composer.json ]; then composer install; fi",
  "postStartCommand": "if ! symfony server:status | grep -q 'Running'; then symfony server:start --daemon --no-tls --allow-http --port=8000; fi"
}